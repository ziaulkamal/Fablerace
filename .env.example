# Salin menjadi .env lalu sesuaikan. Semua konfigurasi via env
# (12-factor, docs/09-devops.md §2) — dibaca internal/platform/config.

APP_ENV=dev                 # dev | staging | prod
HTTP_ADDR=:8080

DATABASE_URL=postgres://fablerace:fablerace@localhost:5432/fablerace?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=fablerace
MINIO_SECRET_KEY=fablerace-secret
MINIO_BUCKET=fablerace
MINIO_USE_SSL=false

# WAJIB diisi di luar dev (aplikasi menolak start) — docs/08-keamanan.md §2.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Dipakai docker-compose untuk service Postgres/MinIO:
POSTGRES_PASSWORD=fablerace
MINIO_ROOT_USER=fablerace
MINIO_ROOT_PASSWORD=fablerace-secret
